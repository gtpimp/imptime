":{"docs":{"features/rough/":{"ref":"features/rough/","tf":0.004016064257028112}}}}}}},"s":{"docs":{"features/rough/":{"ref":"features/rough/","tf":0.004016064257028112}},"a":{"docs":{},"g":{"docs":{"features/rough/":{"ref":"features/rough/","tf":0.004016064257028112}}}}},"p":{"docs":{"features/rough/":{"ref":"features/rough/","tf":0.004016064257028112}}}}},"length":4658},"corpusTokens":["/","1984","1984.","6",":","account","actual","administr","against","ai","alert","alway","anytim","app","approach","assist","autom","avail","balanc","base","becom","behaviour","bill","budget","button","buttons.","captur","chang","changes.","circl","click","clients.","clients/new","clock","collabor","colour","come","compani","comprehens","concept","control","count,","creat","danger","dashboard","defer","defer,","deffer","defin","deleg","detect","dev","develop","development/manag","differ","display","display.","do,","do/defer/delegate,","doing.","don't","done","done,","draw","dure","earlier","easi","eg","email","estim","estimating,","exist","expect","featur","feedback.","full","get","give","go","good","group","gtd","gtd:","guess","happi","happy/sad","have","head","heartrat","home/offic","i'm","import","imptim","inbox","indic","introduct","issu","issue,","it,","key","keyboard","later","life","life.","list","live","look","make","manag","mani","monitor","mood","more","multipl","next","not,","note","notes:","nudg","number","option","order","out","pattern","pedomet","peopl","person","phone","phone,","plan","pressing.","prioriti","prioritis","privaci","privat","process","product","projecct","project","project.","prompt","provid","qualiti","ratio","re","real","reflect","remind","reopen","report","review","right","rough","sad","same","screen,","screenshot","screenshot,","send","set","show","singl","size,","sleep","soft","softwar","solut","someth","something,","spec","sprint","stand","take","that.","thing","those","time","times,","tool","touch","track","tri","typic","unlock","up","us","usag","vs","whole","within","won't","word","work","worthwhil"],"pipeline":["stopWordFilter","stemmer"]},"store":{"./":{"url":"./","title":"Introduction","keywords":"","body":"ImpTime\n"},"features/rough/":{"url":"features/rough/","title":"Rough notes","keywords":"","body":"Rough notes\nKey notes:\n\nproductivity : gtd\naccounting\ncollaborative billing\nbudget\nAI quality control\npersonal assistant : soft touch\n\nInbox\nCreate issues by emailing a project. These issues go into an inbox to be processed\n\nproductivity\n\nReview process\nEasy to draw a list of things to be done and then prioritise\nProject management\nFeature issues\nGroups issues into a single concept\nSprints\nManageable groups of work to be done\nEstimates\nMultiple developers can estimate\nPriorities within a sprint\nSoft touch reminders\nReminders that come at the right time and don't try to control your life.\nDo, Defer, Delegate\nDo\nDefer\nDelegate\nAutomated quality indicators\nIssues\nWhat makes a good issue, eg word count, estimate size, number of times reopened\nLive display of expected issue quality during capture\nSprint\nSame as for issue but for the whole sprint\nProject\nSame as for sprint but for the whole project\nPeople\nLook at typical issue quality vs actual vs happy/sad button\nScreenshot-based speccing\nTake a screenshot, draw circles on it, those become issues\nwhen estimating, show the screenshot with earlier and later issues in different colours\nRe-ordering issues within a screenshot should be an alert\nissues are often estimates based on other issues having been done,\nre-ordering after estimating is dangerous\nBalance Dashboard\nBalance buttons. eg 6 buttons showing the 6 next things worthwhile\ndoing. as they get deffered they change colour and become more pressing.\nGive me something to do\nYou are in different moods at different times, the available options\nwill reflect that.\nLife balance\nSet the ratio of home/office and development/management and existing clients/new clients.\nTrack this ratio and display. Prompt to make changes.\nMonitoring\nReal-time tracking\nAlways tracking time against something, easy to clock-in\nHappy/Sad button\nAnytime on the screen, can click the I'm happy / I'm sad buttons\nReport on issues\nBehavioural Patterns\nBased on do/defer/delegate, guess the mood\nKeyboard tracking\nPhone usage\nhow many times unlock phone, what apps used\nHeartrate\nPedometer\n\nstanding up\nsleep\n\nPrivacy is important\nWe will define what is private and what is not, there won't be an\noption to go full 1984.\n"}}}